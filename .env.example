# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
OWNER_TG_IDS=

# ---- Database ----
# sqlite (local dev)  |  postgresql+asyncpg://user:pass@host:5432/db (prod)
DATABASE_URL=sqlite+aiosqlite:///data/cgm.db

# ---- LLM / Vision (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=google/gemini-2.5-flash
TEXT_MODEL=google/gemini-2.5-flash
# true -> no network calls, deterministic canned answers (local dev & CI)
LLM_MOCK=false

# ---- Speech-to-text (optional; OpenAI-compatible /audio/transcriptions) ----
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ---- Runtime ----
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
# polling | webhook
BOT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ---- Clinical / analysis defaults ----
# canonical storage unit for glucose: mmol/L
DEFAULT_GLUCOSE_UNIT=mmol/L
# postprandial windows, minutes (start-end)
WINDOW_1H=45-90
WINDOW_2H=90-150
# baseline window before the meal, minutes
BASELINE_WINDOW=20
# minimum observations before a product-level conclusion is shown
MIN_OBSERVATIONS=3

# ---- Health platforms ----
# shared secret for the Samsung Health / Health Connect relay endpoint
HEALTH_SYNC_SECRET=
